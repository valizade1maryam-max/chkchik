# Copy to `keystore.properties` (it is git-ignored) and fill in your own values.
# Create a key once with:
#   keytool -genkeypair -v -keystore chikchik-release.jks -alias chikchik \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=chikchik-release.jks
storePassword=CHANGE_ME
keyAlias=chikchik
keyPassword=CHANGE_ME
